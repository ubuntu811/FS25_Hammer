HandToolHammer = {}
HandToolHammer.SPEC_TABLE_NAME = "spec_" .. g_currentModName .. ".hammer"
HandToolHammer.activeOverlayTool = nil

-- =========================================================================
-- HandToolHammer - Core Class (FS25 Standalone Architecture)
-- =========================================================================

HandToolHammer = {}
local HandToolHammer_mt = { __index = HandToolHammer }

-- 1. The Core Constructor (The Shop Manager calls this to spawn the item)
function HandToolHammer.new(baseHandTool, customMetatable)
    local self = {}
    setmetatable(self, customMetatable or HandToolHammer_mt)

    self.baseHandTool = baseHandTool
    self.isClient = g_currentMission.isClient
    self.isServer = g_currentMission.isServer

    print("--> [FS25 SandboxHammer] Object instance generated successfully!")
    return self
end

-- 2. The Initialization Hook (Runs when purchased/loaded)
function HandToolHammer:load(xmlFile, baseDirectory)
    -- Grabs the root node of your hammer mesh
    local rootNode = self.baseHandTool.node
    
    self.spec_hammerTool = {
        -- Tracks your striking transform point from GIANTS Editor (0>1)
        strikingPointNode = I3DUtil.indexToObject(rootNode, "0>1")
    }

    if self.spec_hammerTool.strikingPointNode ~= nil then
        print("--> [FS25 SandboxHammer] Securely linked to strikingPoint node!")
    else
        print("--> [FS25 SandboxHammer] WARNING: strikingPoint node (0>1) not found!")
    end
    
    return true
end

-- 3. Core Lifecycle Cleanup (Prevents memory leaks when tool is sold/deleted)
function HandToolHammer:delete()
    self.spec_hammerTool = nil
end

-- 4. Input Mapping (Captures left-clicks when hammer is equipped)
function HandToolHammer:registerActionEvents(isActiveForInput)
    if self.isClient and isActiveForInput then
        -- Clear old events from the queue
        self.baseHandTool:clearActionEvents()
        
        -- Bind Left Mouse Click (AXIS_HANDTOOL_PRIMARY)
        local _, actionEventId = self.baseHandTool:addActionEvent(
            InputAction.AXIS_HANDTOOL_PRIMARY, 
            self, 
            HandToolHammer.actionCallbackPrimary, 
            false, -- Trigger on release
            true,  -- Trigger on press
            false, -- Is always active
            true   -- Active in menus
        )
        
        g_inputBinding:setActionEventTextPriority(actionEventId, GS_PRIO_HIGH)
        g_inputBinding:setActionEventText(actionEventId, "Swing Sandbox Hammer")
    end
end

-- 5. The Execution Trigger!
function HandToolHammer:actionCallbackPrimary(actionName, inputValue, callbackState, isAnalog)
    if inputValue == 1 then 
        print("--> [FS25 SandboxHammer] BANG! Hammer swing registered.")
        -- This is where your raycast function will sit next!
    end
end

-- Mandatory structural loops required by HandTool.lua
function HandToolHammer:update(dt, isActiveForInput) end
function HandToolHammer:onActivate() print("--> Hammer equipped!") end
function HandToolHammer:onDeactivate() print("--> Hammer holstered.") end


