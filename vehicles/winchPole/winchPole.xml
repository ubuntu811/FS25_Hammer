<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="winchPole" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">
    <annotation>Winch pole (FS25_Hammer), made by tools/make_winch_pole.py.</annotation>

    <storeData>
        <name>
            <en>Winch pole</en>
        </name>
        <functions>
            <function>A wide iron plate with an upright post and three winch latches (yellow: two at the top on opposite sides, one low). Light enough to carry in your hands (the hands tool takes up to 200 kg), or drag it by the orange eye on the plate (a tractor, or the hand winch): stand it where you want it, and pin it with the Sandbox Hammer: pinned it weighs 3 t, cannot be lifted and does not move, so a winch can pull a bridge against it. Only a winch takes a latch (the tractor's winch rope, the hand winch).</function>
        </functions>
        <image>vehicles/winchPole/store_winchPole.dds</image>
        <price>300</price>
        <lifetime>1000</lifetime>
        <category>SANDBOX_WORKS</category>
        <brand>NONE</brand>
        <showInStore>true</showInStore>
        <canBeSold>true</canBeSold>
        <allowLeasing>false</allowLeasing>
        <financeCategory>OTHER</financeCategory>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <storeIconRendering>
            <settings cameraXRot="-25" cameraYRot="35" />
        </storeIconRendering>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <typeDesc>Winch pole</typeDesc>
        <filename>vehicles/winchPole/winchPole.i3d</filename>
        <size width="1.3" length="1.5" height="2.4" lengthOffset="0"/>
        <canBeReset>true</canBeReset>
        <supportsPickUp>true</supportsPickUp>
        <components maxMass="4000">
            <component centerOfMass="0 0.35 0" solverIterationCount="10" mass="120"/>
        </components>
        <showInVehicleMenu>true</showInVehicleMenu>
        <mapHotspot available="false" />
        <input allowed="false"/>
    </base>

    <!-- the winch latches: only a winch takes them (joint type winchLatch of FS25_Hammer) -->
    <attacherJoints>
        <attacherJoint node="latch1" jointType="winchLatch" />
        <attacherJoint node="latch2" jointType="winchLatch" />
        <attacherJoint node="latch3" jointType="winchLatch" />
    </attacherJoints>

    <i3dMappings>
        <i3dMapping id="winchPole_main_component1" node="0>" />
        <i3dMapping id="latch1" node="0>2" />
        <i3dMapping id="latch2" node="0>3" />
        <i3dMapping id="latch3" node="0>4" />
        <i3dMapping id="bolts" node="0>5" />
    </i3dMappings>
</vehicle>
